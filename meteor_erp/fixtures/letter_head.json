  "content": "<!-- === FORM HEADER (Compact Version) === -->\n<table style=\"width:100%;\n  border:1px solid #000 !important;\n  border-collapse:collapse !important;\n  font-size:13px !important;\n  line-height:1.2 !important;\n  margin-top:2px !important;\n  margin-bottom:4px !important;\">\n  <tbody>\n    <tr>\n      <!-- LOGO -->\n      <td rowspan=\"5\" style=\"width:22%; text-align:center; vertical-align:middle; border:1px solid #000 !important;\">\n        {% set logo = frappe.db.get_value(\"Company\", doc.company, \"company_logo\") %}\n        {% if logo %}\n          <img src=\"{{ logo }}\" width=\"40\" alt=\"Company Logo\" style=\"object-fit:contain; margin-bottom:2px;\">\n        {% endif %}\n        <div style=\"font-weight:bold; font-size:11px; margin-top:2px;\">PT INDO GREENLIFE HARVEST</div>\n      </td>\n\n      <!-- TITLE -->\n      <td rowspan=\"2\" colspan=\"3\" style=\"width:30%;\n        text-align:center;\n        font-weight:bold;\n        border:1px solid #000 !important;\n        padding:3px !important;\">\n        FORMULIR<br><span style=\"font-size:14px;\"></span>\n      </td>\n\n      <!-- KANAN ATAS -->\n      <td style=\"width:14%; border:1px solid #000 !important; padding:3px !important;\">Halaman</td>\n      <td style=\"width:14%; border:1px solid #000 !important; padding:3px !important;\">1 dari 2</td>\n    </tr>\n\n    <tr>\n      <td style=\"border:1px solid #000 !important; padding:3px !important;\">No. Dok</td>\n      <td style=\"border:1px solid #000 !important; padding:3px !important;\">: {{ doc.name }}</td>\n    </tr>\n\n    <tr>\n      <td colspan=\"3\" rowspan=\"3\" style=\"text-align:center;\n        border:1px solid #000 !important;\n        font-weight:bold;\n        vertical-align:middle !important;\n        padding:3px !important;\">\n        {{ doc.doctype }}\n      </td>\n      <td style=\"border:1px solid #000 !important; padding:3px !important;\">Revisi</td>\n      <td style=\"border:1px solid #000 !important; padding:3px !important;\">: 0</td>\n    </tr>\n\n    <tr>\n      <td style=\"border:1px solid #000 !important; padding:3px !important;\">Berlaku</td>\n      <td style=\"border:1px solid #000 !important; padding:3px !important;\">: -</td>\n    </tr>\n\n    <tr>\n      <td style=\"border:1px solid #000 !important; padding:3px !important;\">Dibuat Oleh</td>\n      <td style=\"border:1px solid #000 !important; padding:3px !important;\">: Admin</td>\n    </tr>\n  </tbody>\n</table>\n",
