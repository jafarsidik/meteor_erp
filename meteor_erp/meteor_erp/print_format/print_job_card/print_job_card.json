 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% if letter_head %}\r\n{{ letter_head }}\r\n{% endif %}\r\n\r\n{% set company_logo = frappe.db.get_value(\"Company\", doc.company, \"company_logo\") %}\r\n\r\n<!-- === HEADER COMPANY === -->\r\n<table style=\"\r\n  margin-top:6px;\r\n  width:100%;\r\n  border:1px solid #000 !important;\r\n  border-radius:6px !important;\r\n  border-collapse:separate !important;\r\n  border-spacing:0 !important;\r\n\">\r\n  <tr>\r\n    <td style=\"width:70%; padding:8px !important; vertical-align:middle;\">\r\n      <table style=\"width:100%;\">\r\n        <tr>\r\n          <td style=\"width:90px; vertical-align:middle;\">\r\n            {% if company_logo %}\r\n              <img src=\"{{ company_logo }}\" width=\"70\" style=\"object-fit:contain;\">\r\n            {% endif %}\r\n          </td>\r\n          <td style=\"vertical-align:middle; text-align:left !important; padding-left:8px !important;\">\r\n            <div style=\"font-weight:bold; text-transform:uppercase; font-size:14px;\">\r\n              {{ doc.company }}\r\n            </div>\r\n            <div style=\"font-size:12px; line-height:1.4;\">\r\n              Komplek Pergudangan & Industri Era Prima<br>\r\n              Jl. Daan Mogot KM 21 No.1 Blok Q1\r\n            </div>\r\n          </td>\r\n        </tr>\r\n      </table>\r\n    </td>\r\n\r\n    <td style=\"\r\n      width:30%;\r\n      font-size:20px !important;\r\n      font-weight:bold !important;\r\n      text-align:center !important;\r\n      vertical-align:middle !important;\r\n      background-color:#f9f9f9 !important;\r\n    \">\r\n      JOB CARD\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n<!-- === JOB CARD INFO === -->\r\n<table style=\"\r\n  margin-top:8px;\r\n  width:100%;\r\n  border:1px solid #000 !important;\r\n  border-radius:6px !important;\r\n  border-collapse:separate !important;\r\n  border-spacing:0 !important;\r\n\">\r\n  <tr>\r\n    <td style=\"width:55%; border-right:1px solid #000 !important; padding:8px !important; vertical-align:top;\">\r\n      <strong>Work Order:</strong><br>\r\n      <div style=\"margin-left:8px;\">\r\n        {{ doc.work_order or '-' }}<br>\r\n        {{ doc.production_item or '' }}<br>\r\n        {{ doc.item_name or '' }}\r\n      </div>\r\n      <hr style=\"border:0; border-top:1px dashed #999; margin:6px 0;\">\r\n      <strong>Operation:</strong><br>\r\n      <div style=\"margin-left:8px;\">\r\n        {{ doc.operation or '-' }}<br>\r\n        Workstation: {{ doc.workstation or '-' }}\r\n      </div>\r\n    </td>\r\n\r\n    <td style=\"width:45%; padding:6px !important; vertical-align:top;\">\r\n      <table style=\"width:100%; border-collapse:collapse !important; font-size:12px;\">\r\n        <tr>\r\n          <td style=\"border:1px solid #000 !important; width:50%;\">\r\n            <b>Job Card No</b><br>{{ doc.name }}\r\n          </td>\r\n          <td style=\"border:1px solid #000 !important;\">\r\n            <b>Date</b><br>{{ frappe.format_date(doc.posting_date) }}\r\n          </td>\r\n        </tr>\r\n        <tr>\r\n          <td style=\"border:1px solid #000 !important;\"><b>Status</b><br>{{ doc.status }}</td>\r\n          <td style=\"border:1px solid #000 !important;\"><b>Company</b><br>{{ doc.company }}</td>\r\n        </tr>\r\n        <tr>\r\n          <td style=\"border:1px solid #000 !important;\"><b>Produced Qty</b><br>{{ doc.total_completed_qty or 0 }}</td>\r\n          <td style=\"border:1px solid #000 !important;\"><b>Operation Time (Hrs)</b><br>{{ doc.total_operation_time or 0 }}</td>\r\n        </tr>\r\n      </table>\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n<!-- === EMPLOYEES / OPERATORS === -->\r\n<table style=\"margin-top:12px; width:100%; border-collapse:collapse;\">\r\n  <thead>\r\n    <tr style=\"background-color:#f2f2f2;\">\r\n      <th style=\"border:1px solid #000; width:5%;\">No</th>\r\n      <th style=\"border:1px solid #000; width:35%;\">Employee</th>\r\n      <th style=\"border:1px solid #000; width:30%;\">Operation</th>\r\n      <th style=\"border:1px solid #000; width:15%;\">Start Time</th>\r\n      <th style=\"border:1px solid #000; width:15%;\">End Time</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% for row in doc.time_logs %}\r\n    <tr>\r\n      <td style=\"border:1px solid #000; text-align:center;\">{{ loop.index }}</td>\r\n      <td style=\"border:1px solid #000;\">{{ row.employee_name or row.employee }}</td>\r\n      <td style=\"border:1px solid #000;\">{{ row.operation or '-' }}</td>\r\n      <td style=\"border:1px solid #000; text-align:center;\">{{ frappe.format_datetime(row.from_time) if row.from_time else '-' }}</td>\r\n      <td style=\"border:1px solid #000; text-align:center;\">{{ frappe.format_datetime(row.to_time) if row.to_time else '-' }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n  </tbody>\r\n</table>\r\n\r\n<!-- === MATERIALS USED === -->\r\n{% if doc.materials %}\r\n<table style=\"margin-top:12px; width:100%; border-collapse:collapse;\">\r\n  <thead>\r\n    <tr style=\"background-color:#f2f2f2;\">\r\n      <th style=\"border:1px solid #000; width:5%;\">No</th>\r\n      <th style=\"border:1px solid #000; width:40%;\">Material</th>\r\n      <th style=\"border:1px solid #000; width:15%;\">Qty</th>\r\n      <th style=\"border:1px solid #000; width:15%;\">UOM</th>\r\n      <th style=\"border:1px solid #000; width:25%;\">Source Warehouse</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% for row in doc.materials %}\r\n    <tr>\r\n      <td style=\"border:1px solid #000; text-align:center;\">{{ loop.index }}</td>\r\n      <td style=\"border:1px solid #000;\">{{ row.item_name or row.item_code }}</td>\r\n      <td style=\"border:1px solid #000; text-align:center;\">{{ row.required_qty | int }}</td>\r\n      <td style=\"border:1px solid #000; text-align:center;\">{{ row.uom }}</td>\r\n      <td style=\"border:1px solid #000; text-align:center;\">{{ row.source_warehouse or '-' }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n  </tbody>\r\n</table>\r\n{% endif %}\r\n\r\n<!-- === REMARKS / NOTES === -->\r\n<table style=\"margin-top:12px; width:100%;\">\r\n  <tr>\r\n    <td style=\"padding:8px; border:1px solid #000;\">\r\n      <strong>Remarks:</strong><br>\r\n      {{ doc.remarks or '-' }}\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n<!-- === SIGNATURE SECTION === -->\r\n<table style=\"margin-top:25px; width:100%; text-align:center;\">\r\n  <tr>\r\n    <td><strong>Prepared By</strong></td>\r\n    <td><strong>Checked By</strong></td>\r\n    <td><strong>Approved By</strong></td>\r\n  </tr>\r\n  <tr style=\"height:80px;\">\r\n    <td style=\"border-top:1px solid #000;\">Date: {{ frappe.format_date(doc.posting_date) }}</td>\r\n    <td style=\"border-top:1px solid #000;\">Date: {{ frappe.format_date(doc.posting_date) }}</td>\r\n    <td style=\"border-top:1px solid #000;\">Date: {{ frappe.format_date(doc.posting_date) }}</td>\r\n  </tr>\r\n</table>\r\n",
